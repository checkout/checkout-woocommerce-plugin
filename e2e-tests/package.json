{
  "name": "checkout-com-woocommerce-e2e",
  "private": true,
  "description": "Playwright UI/E2E tests for the Checkout.com WooCommerce plugin, run against a pinned wp-env store.",
  "scripts": {
    "env:start": "cd .. && ./e2e-tests/node_modules/.bin/wp-env start",
    "env:stop": "cd .. && ./e2e-tests/node_modules/.bin/wp-env stop",
    "env:destroy": "cd .. && ./e2e-tests/node_modules/.bin/wp-env destroy",
    "env:seed": "node -r dotenv/config -e \"require('child_process').execSync('../bin/e2e/seed.sh', { stdio: 'inherit', env: process.env })\"",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@wordpress/env": "^12.0.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
