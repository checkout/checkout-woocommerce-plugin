# Copy to .env (git-ignored). Used by `npm run env:seed` and by the tests.

# Checkout.com SANDBOX credentials (required). Use a sandbox account dedicated to testing.
CKO_PUBLIC_KEY=pk_sbox_xxxxxxxxxxxxxxxxxxxxxxxxxx
CKO_SECRET_KEY=sk_sbox_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Client ID (cli_...) - its first 8 chars are the merchant API subdomain.
CKO_CLIENT_ID=
# Optional: Processing Channel ID (pc_...), if the account requires it.
CKO_PROCESSING_CHANNEL_ID=

# Test store (defaults match .wp-env.json).
BASE_URL=http://localhost:8890
E2E_CUSTOMER_PASSWORD=password
