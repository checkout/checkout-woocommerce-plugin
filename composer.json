{
    "config": {
        "platform": {
            "php": "7.3"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": ">=7.3",
        "checkout/checkout-sdk-php": "3.2.*",
        "wp-cli/wp-cli-bundle": "^2.6"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.6",
        "automattic/vipwpcs": "^3",
        "phpcompatibility/phpcompatibility-wp": "^2"
    },
    "scripts": {
        "prefix-namespaces": [
            "sh -c 'test -f ./bin/strauss.phar || curl -sSfL -o bin/strauss.phar https://github.com/BrianHenryIE/strauss/releases/download/0.31.1/strauss.phar'",
            "@php -r \"if ( hash_file( 'sha256', 'bin/strauss.phar' ) !== '17dc2baf27b9a3f52834e3db729c8365d8915a80e37a087d253cf705387aa887' ) { fwrite( STDERR, 'bin/strauss.phar is not Strauss 0.31.1 (checksum mismatch). Delete it and run composer install again.' . PHP_EOL ); exit( 1 ); }\"",
            "@php bin/strauss.phar",
            "@composer dump-autoload"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ]
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor",
            "namespace_prefix": "CheckoutComWC\\Vendor\\",
            "classmap_prefix": "CheckoutComWC_Vendor_",
            "packages": [
                "monolog/monolog",
                "checkout/checkout-sdk-php",
                "guzzlehttp/guzzle",
                "guzzlehttp/promises",
                "guzzlehttp/psr7",
                "psr/http-client",
                "psr/http-factory",
                "psr/http-message",
                "psr/log"
            ],
            "exclude_from_prefix": {
                "packages": [
                    "checkout/checkout-sdk-php"
                ]
            },
            "update_call_sites": true,
            "delete_vendor_packages": false,
            "classmap_output": true
        }
    }
}
